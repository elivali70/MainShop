@using App.EndPoint.Mvc.ShopUI.Areas.Admin.Models.ViewModel.Brand
@model List<BrandOutPutViewModel>
@{
    ViewData["Title"] = "لیست برندها";
    Model.OrderBy(o => o.DisplayOrder);
    int row = 1;
}
<div class="d-flex justify-content-between align-items-center mb-3">
    <h2>لیست برندها</h2>

    <a asp-area="Admin" asp-controller="Brand" asp-action="Create" class="btn btn-icon-split btn-primary btn-lg">
        افزودن ‌برند+
    </a>
</div>

<div class="card shadow mb-4">
    <div class="card-header py-3">
        <h6 class="m-0 font-weight-bold text-primary">لیست برندها</h6>
    </div>
    <div class="card-body">
        <div class="table-responsive">
            <table class="table table-bordered" id="dataTable" width="100%" cellspacing="0">
                <thead>
                    <tr>
                        <th scope="col">ردیف</th>
                        <th scope="col">شتاسه</th>
                        <th scope="col">تام</th>
                        <th scope="col">تاریخ ایجاد</th>
                        <th scope="col">عملیات</th>
                    </tr>
                </thead>
                <tfoot>
                    <tr>
                        <th scope="col">ردیف</th>
                        <th scope="col">شتاسه</th>
                        <th scope="col">تام</th>
                        <th scope="col">تاریخ ایجاد</th>
                        <th scope="col">عملیات</th>
                    </tr>
                </tfoot>
                <tbody>
                   
                    @foreach (var brand in Model)
                    {
                        <tr>
                            <td>@row</td>
                            <td>@brand.Id</td>
                            <td>@brand.Name</td>
                            <td>@brand.CreationDate</td>
                           
                            <td>
                                <a asp-area="Admin" asp-controller="Brand" asp-action="Update" asp-route-id="@brand.Id" class="btn  btn-danger "> ویرایش </a>
                                <a  asp-area="Admin" asp-controller="Brand" asp-action="Detail" asp-route-id="@brand.Id" class="btn btn-info"> جزئیات </a>
                                <a asp-area="Admin" asp-controller="Brand" asp-action="Delete" asp-route-id="@brand.Id" class="btn btn-warning  "> حذف </a>

                            </td>
                        </tr>
                        row++;
                    }
               

                </tbody>
            </table>
        </div>
    </div>
</div>

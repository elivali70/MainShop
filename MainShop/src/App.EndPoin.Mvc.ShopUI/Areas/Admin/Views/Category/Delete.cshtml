@using App.EndPoint.Mvc.ShopUI.Areas.Admin.Models.ViewModel.Category
@model CategoryOutPutViewModel

@{
    ViewData["Title"] = "حذف برند";

}
<form asp-area="Admin" asp-controller="Category" asp-action="Delete" method="post">

    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2> حذف دسته بندی @Model.Name</h2>
    </div>

    <div class="card shadow mb-4">
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-bordered" id="dataTable" width="100%" cellspacing="0">
                    <thead>
                        <tr>
                            <th scope="col">نام</th>
                            <th scope="col">ترتیب نمایش</th>

                        </tr>
                    </thead>
                    <tfoot>
                        <tr>
                            <th scope="col">نام</th>
                            <th scope="col">ترتیب نمایش</th>
                        </tr>
                    </tfoot>
                    <tbody>

                        <tr>
                            <td>@Model.Name</td>
                            <td>@Model.DisplayOrder</td>
                        </tr>
                    </tbody>

                </table>
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h3 class="col-2">آیا از حذف برند @Model.Name اطمینان دارید؟</h3>
                    <input type="submit" class="btn btn-success" value="بله" />
                    <a asp-area="Admin" asp-controller="Category" asp-action="Index" class="btn btn-primary  "> انصراف </a>

                </div>
            </div>
        </div>
    </div>
</form>




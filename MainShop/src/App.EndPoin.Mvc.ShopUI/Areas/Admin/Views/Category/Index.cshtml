
@using App.EndPoint.Mvc.ShopUI.Areas.Admin.Models.ViewModel.Category
@model List<CategoryOutPutViewModel>
@{
    ViewData["Title"] = "لیست دسته بندی ها";
    Model.OrderBy(o => o.DisplayOrder);
    int row = 1;
}
<div class="d-flex justify-content-between align-items-center mb-3">
    <h2>لیست دسته بندی ها</h2>

    <a asp-area="Admin" asp-controller="Category" asp-action="Create" class="btn btn-icon-split btn-primary btn-lg">
        افزودن ‌دسته بندی+
    </a>
</div>

<div class="card shadow mb-4">
    <div class="card-header py-3">
        <h6 class="m-0 font-weight-bold text-primary">لیست برندها</h6>
    </div>
    <div class="card-body">
        <div class="table-responsive">
            <table class="table table-bordered" id="dataTable" width="100%" cellspacing="0">
                <thead>
                    <tr>
                        <th scope="col">ردیف</th>
                        <th scope="col">شتاسه</th>
                        <th scope="col">تام</th>
                        <th scope="col">ترتیب نمایش</th>
                        <th scope="col">دسته بندی اصلی</th>
                        <th scope="col">وضعیت</th>
                        <th scope="col">عملیات</th>
                    </tr>
                </thead>
                <tfoot>
                    <tr>
                        <th scope="col">ردیف</th>
                        <th scope="col">شتاسه</th>
                        <th scope="col">تام</th>
                        <th scope="col">ترتیب نمایش</th>
                        <th scope="col">دسته بندی اصلی</th>
                        <th scope="col">وضعیت</th>
                        <th scope="col">عملیات</th>
                    </tr>
                </tfoot>
                <tbody>

                    @foreach (var category in Model)
                    {
                        <tr>
                            <td>@row</td>
                            <td>@category.Id</td>
                            <td>@category.Name</td>
                            <td>@category.DisplayOrder</td>
                            <td>@category.ParentCategoryId</td>
                           
                            <td>
                                @if (category.IsActive)
                                {
                                    <span class="badge bg-success">فعال</span>
                                }
                                else
                                {
                                    <span class="badge bg-danger">غیرفعال</span>
                                }

                            </td>

                            <td>
                                <a asp-area="Admin" asp-controller="Category" asp-action="Update" asp-route-id="@category.Id" class="btn  btn-danger "> ویرایش </a>
                                <a asp-area="Admin" asp-controller="Category" asp-action="Detail" asp-route-id="@category.Id" class="btn btn-info"> جزئیات </a>
                                <a asp-area="Admin" asp-controller="Category" asp-action="Delete" asp-route-id="@category.Id" class="btn btn-warning  "> حذف </a>

                            </td>
                        </tr>
                        row++;
                    }


                </tbody>
            </table>
        </div>
    </div>
</div>

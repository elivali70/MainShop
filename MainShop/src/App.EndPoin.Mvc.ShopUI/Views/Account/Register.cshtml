@model RegisterViewModel
@{
    ViewData["Title"] = "ثبت نام";
}
<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-6 col-lg-5">
            <form asp-controller="Account" asp-action="Register" method="post">
                <h4>ساخت حساب کاربری جدید</h4>
                <hr />
                <div class="form-group">
                    <label asp-for="Email" class="col-sm-2 col-form-label"></label>
                    <input asp-for="Email" class="form-control" />
                    <span asp-validation-for="Email" class="text-bg-danger"></span>
                </div>
                <div class="form-group">
                    <label asp-for="Password" class="col-sm-2 col-form-label"></label>
                    <div class="input-group">
                        <input type="password" id="password" asp-for="Password" class="form-control" placeholder="رمز عبور را وارد کنید" />
                        <button type="button" class="btn btn-outline-secondary"
                                onclick="togglePassword('password', this)">
                            <i class="fa fa-eye"></i>
                        </button>
                    </div>
                </div>
                <span asp-validation-for="Password" class="text-bg-danger"></span>

        <div class="form-group">
            <label asp-for="ConfirmPassWord" class="col-sm-2 col-form-label"></label>
            <div class="input-group">
                <input type="password" id="confirmpassword" asp-for="ConfirmPassWord" class="form-control" placeholder="رمز عبور را تکرار کنید" />
                <button type="button" class="btn btn-outline-secondary"
                        onclick="togglePassword('confirmpassword', this)">
                    <i class="fa fa-eye"></i>
                </button>


            </div>
        </div>
        <span asp-validation-for="ConfirmPassWord" class="text-bg-danger"></span>

        <input type="submit" class="btn btn-primary" value="ثبت نام" />
        </form>
    </div>
</div>
</div>


<script>
    function togglePassword(inputId, button) {
        const input = document.getElementById(inputId);
        const icon = button.querySelector('i');

        if (input.type === 'password') {
            input.type = 'text';
            icon.classList.replace('fa-eye', 'fa-eye-slash');
        } else {
            input.type = 'password';
            icon.classList.replace('fa-eye-slash', 'fa-eye');
        }
    }
</script>
